# ============================================
# Uni-Admin Web 环境变量配置模板
# ============================================
# 复制此文件为对应环境的 .env 文件并填入实际值：
#   开发环境: cp .env.example .env.development
#   本地覆盖: cp .env.example .env.local
#
# 变量命名规范:
#   VITE_APP_*   → 应用基础信息
#   VITE_API_*   → API 服务配置
#   VITE_FEATURE_* / VITE_ENABLE_* → 功能开关
#   VITE_BUILD_* → 构建元数据（自动注入，无需手动设置）
#
# 注意：只有以 VITE_ 为前缀的变量才会暴露到前端代码

# ============================================
# 应用基础配置
# ============================================

# 应用标题（显示在浏览器标签页）
# 类型: string | 必填
VITE_APP_TITLE=Uni-Admin 管理后台

# 当前运行环境
# 类型: 'development' | 'test' | 'production' | 必填
VITE_APP_ENV=development

# ============================================
# API 服务配置
# ============================================

# API 基础地址
# 开发环境通常使用相对路径（配合 vite proxy）
# 生产环境填写完整的 API 域名
# 类型: string (URL) | 必填
VITE_API_BASE_URL=/api/v1

# API 请求超时时间（毫秒）
# 类型: number (正整数) | 可选，默认 15000
VITE_API_TIMEOUT=15000

# ============================================
# 功能开关
# ============================================

# 是否启用 Vue DevTools（生产环境必须关闭）
# 类型: boolean ('true'/'1' → true, 其他 → false)
# 默认值: false; 生产环境强制 false
VITE_ENABLE_DEVTOOLS=false

# ============================================
# 构建元数据（自动注入，无需手动设置）
# ============================================
# 以下变量由 vite.config.ts 的 define 配置在构建时自动注入:
#   VITE_BUILD_VERSION  → 从 package.json.version 读取
#   VITE_BUILD_TIME     → ISO 8601 格式的 UTC 时间戳
