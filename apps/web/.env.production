# ============================================
# Uni-Admin Web 生产环境配置
# ============================================

# ---------- 应用基础配置 ----------
VITE_APP_TITLE=Uni-Admin
VITE_APP_ENV=production

# ---------- API 服务配置 ----------
# 生产环境使用完整域名（由 CI/CD 或 Nginx 反代处理）
VITE_API_BASE_URL=https://api.example.com
VITE_API_TIMEOUT=8000

# ---------- 功能开关 ----------
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEVTOOLS=false

# ---------- 路由系统配置 ----------
VITE_ROUTER_MODE=backend
VITE_MENU_CACHE=true
VITE_MENU_CACHE_TTL=1800000
VITE_HOVER_DELAY=150
VITE_PREFETCH_ENABLED=true
VITE_MAX_PREFETCH_CACHE=10
