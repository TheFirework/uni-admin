# ============================================
# Uni-Admin Web 开发环境配置
# ============================================

# ---------- 应用基础配置 ----------
VITE_APP_TITLE=Uni-Admin Dev
VITE_APP_ENV=development

# ---------- API 服务配置 ----------
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT=15000

# ---------- 功能开关 ----------
VITE_ENABLE_MOCK=true
VITE_ENABLE_DEVTOOLS=true
