# ============================================
# Uni-Admin Server 生产环境配置
# ============================================
# ⚠️ 敏感变量（DATABASE_URL/JWT_SECRET/REDIS_PASSWORD）请通过 CI/CD Secrets 注入
#     不要将真实密钥提交到 Git 仓库

NODE_ENV=production
PORT=3000
DATABASE_URL=${DATABASE_URL}
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=${REDIS_DB:-0}
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=${ENCRYPTION_KEY}
HMAC_SECRET=${HMAC_SECRET}
CORS_ORIGINS=https://your-domain.com
ENABLE_SWAGGER=false
ENABLE_BULL_DASHBOARD=false
ENABLE_KNIFE4J=false
