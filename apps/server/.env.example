# ============================================
# Uni-Admin Server 环境变量配置模板
# ============================================
# 复制此文件为对应环境的 .env 文件并填入实际值：
#   开发环境: cp .env.example .env.development
#   本地覆盖: cp .env.example .env.local
#
# 加载顺序（后加载的覆盖先加载的）:
#   .env → .env.[mode] → .env.local → .env.[mode].local
#
# 敏感信息安全:
#   ✅ DATABASE_URL、JWT_SECRET、REDIS_PASSWORD 使用占位符
#   ✅ 生产环境通过 CI/CD Secrets 注入真实密钥
#   ❌ 绝不将真实密码或密钥提交到 Git

# ============================================
# 运行环境
# ============================================

# Node.js 运行环境
# 类型: 'development' | 'test' | 'production' | 必填
NODE_ENV=development

# 服务监听端口
# 类型: number (1-65535) | 可选，默认 3000
PORT=3000

# ============================================
# 数据库配置 (MySQL)
# ============================================

# MySQL 连接字符串
# 格式: mysql://用户名:密码@主机:端口/数据库名
# 类型: string (MySQL URL) | 必填
# ⚠️ 生产环境请使用 CI/CD Secrets 注入
DATABASE_URL=mysql://admin:CHANGE_ME@localhost:3306/uni_admin

# ============================================
# Redis 配置
# ============================================

# Redis 主机地址
# 类型: string (hostname/IP) | 可选，默认 localhost
REDIS_HOST=localhost

# Redis 端口
# 类型: number (1-65535) | 可选，默认 6379
REDIS_PORT=6379

# Redis 密码（无密码则留空）
# 类型: string | 可选，默认空
# ⚠️ 生产环境如有密码请使用 CI/CD Secrets 注入
REDIS_PASSWORD=

# Redis 数据库编号
# 类型: number (0-15) | 可选，默认 0
REDIS_DB=0

# ============================================
# JWT 认证配置
# ============================================

# JWT 签名密钥（Access Token 和 RefreshToken 共用）
# 类型: string | 必填
# ⚠️⚠️⚠️ 务必在生产环境中更改为强随机密钥！
#    可使用: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Access Token 过期时间
# 类型: string (如: '7d', '24h', '30m') | 可选，默认 7d
JWT_EXPIRES_IN=7d

# ============================================
# 加密密钥配置
# ============================================

# AES-256 加密主密钥
# 类型: string | 可选，有安全默认值
ENCRYPTION_KEY=default-encryption-key-32-characters-long!!

# HMAC 签名密钥（留空则使用 ENCRYPTION_KEY）
# 类型: string | 可选
HMAC_SECRET=

# ============================================
# CORS 跨域配置
# ============================================

# 允许的跨域来源（逗号分隔）
# 类型: string (逗号分隔的 URL 列表) | 可选
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# 功能开关
# ============================================

# 是否启用 Swagger API 文档
# 类型: boolean ('true'/'1' → true, 其他 → false)
# 默认值: false; 生产环境强制 false
ENABLE_SWAGGER=false

# 是否启用 Bull Dashboard 面板
# 类型: boolean ('true'/'1' → true, 其他 → false)
ENABLE_BULL_DASHBOARD=false

# 是否启用 Knife4j 增强 UI
# 类型: boolean ('false'/'0' → false, 其他 → true)
ENABLE_KNIFE4J=true
