// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户模型
model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique @map("username") @db.VarChar(50)
  email     String    @unique @map("email") @db.VarChar(100)
  nickname  String?   @map("nickname") @db.VarChar(50)
  avatar    String?   @map("avatar") @db.VarChar(255)
  status    Int       @default(1) @map("status")
  password  String    @map("password") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

// 角色模型
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @map("name") @db.VarChar(50)
  code        String   @unique @map("code") @db.VarChar(50)
  description String?  @map("description") @db.VarChar(255)
  status      Int      @default(1) @map("status")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("roles")
}

// 菜单模型（适配前端 MenuDTO 结构）
// permission 字段存储访问权限标识，格式：JSON数组如 ["admin","system:user:list"]
model Menu {
  id          Int      @id @default(autoincrement())
  parentId    Int?     @map("parent_id")
  name        String   @unique @map("name") @db.VarChar(100)
  path        String?  @map("path") @db.VarChar(255)
  component   String?  @map("component") @db.VarChar(255)
  redirect    String?  @map("redirect") @db.VarChar(255)
  routeName   String?  @map("route_name") @db.VarChar(100)
  icon        String?  @map("icon") @db.VarChar(100)
  title       String?  @map("title") @db.VarChar(100)
  hidden      Boolean  @default(false) @map("hidden")
  affix       Boolean  @default(false) @map("affix")
  noCache     Boolean  @default(false) @map("no_cache")
  externalLink String? @map("external_link") @db.VarChar(500)
  permission  String?  @map("permission") @db.Text // JSON: ["admin","system:user:list"] → meta.access
  sort        Int      @default(0) @map("sort")
  visible     Boolean  @default(true) @map("visible")
  status      Int      @default(1) @map("status")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent     Menu?    @relation("MenuParent", fields: [parentId], references: [id])
  children   Menu[]   @relation("MenuParent")

  @@map("menus")
}

// 字典模型
model Dictionary {
  id        Int      @id @default(autoincrement())
  type      String   @map("type") @db.VarChar(50)
  label     String   @map("label") @db.VarChar(100)
  value     String   @map("value") @db.VarChar(255)
  sort      Int      @default(0) @map("sort")
  status    Int      @default(1) @map("status")
  remark    String?  @map("remark") @db.Text

  @@map("dictionary")
}

// 系统配置模型
model SystemConfig {
  id         Int      @id @default(autoincrement())
  configKey  String   @unique @map("config_key") @db.VarChar(100)
  configValue String  @map("config_value") @db.Text
  groupName  String   @map("group_name") @db.VarChar(50)
  remark     String?  @map("remark") @db.Text
  status     Int      @default(1) @map("status")

  @@map("system_config")
}
