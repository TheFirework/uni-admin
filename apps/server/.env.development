# ============================================
# Uni-Admin Server 开发环境配置
# ============================================

# ---------- 运行环境 ----------
NODE_ENV=development
PORT=3000

# ---------- 数据库配置 (MySQL) ----------
DATABASE_URL=mysql://root:root_password@localhost:3306/uni_admin

# ---------- Redis 配置 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT 认证配置 ----------
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# ---------- 加密密钥配置 ----------
ENCRYPTION_KEY=dev-encryption-key-32-chars-long!!!
HMAC_SECRET=

# ---------- CORS 配置 ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 功能开关 ----------
ENABLE_SWAGGER=true
ENABLE_BULL_DASHBOARD=false
ENABLE_KNIFE4J=true
