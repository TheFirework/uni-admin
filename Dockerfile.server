# ===========================================
# Dockerfile.server - NestJS 后端多阶段构建
# ===========================================

# 构建阶段：安装依赖并编译 TypeScript
FROM node:20-alpine AS builder

# 安装 pnpm
RUN corepack enable && pnpm install -g pnpm@8

WORKDIR /app

# 先复制包管理文件（利用 Docker 层缓存）
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/server/package.json ./apps/server/
COPY packages/*/package.json ./packages/*/

# 安装依赖（只安装 production dependencies 用于构建）
RUN pnpm install --frozen-lockfile

# 复制源码
COPY . .

# 构建 NestJS Server
RUN pnpm --filter @uni-admin/server build

# 生产运行阶段：最小化镜像体积
FROM node:20-alpine AS runner

# 安装 dumb-init 以正确处理信号
RUN apk add --no-cache dumb-init

WORKDIR /app

# 设置环境变量
ENV NODE_ENV=production

# 只复制必要的文件
COPY --from=builder /app/apps/server/package.json ./
COPY --from=builder /app/apps/server/dist ./dist
COPY --from=builder /app/apps/server/prisma ./prisma
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/pnpm-lock.yaml ./
COPY --from=builder /app/packages/shared-types/package.json ./packages/shared-types/
COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder /app/packages/shared-utils/package.json ./packages/shared-utils/
COPY --from=builder /app/packages/shared-utils/dist ./packages/shared-utils/dist

# 安装生产依赖（只安装 server 需要的）
RUN corepack enable && \
    pnpm install --prod --filter @uni-admin/server... && \
    # 清理 pnpm 缓存以减小镜像体积
    rm -rf /root/.local/share/pnpm/store

# 生成 Prisma Client（如果使用 Prisma）
RUN npx prisma generate

# 暴露端口
EXPOSE 3000

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

# 使用 dumb-init 作为 PID 1 进程
ENTRYPOINT ["dumb-init", "--"]

# 启动命令
CMD ["node", "dist/main.js"]